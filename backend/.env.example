# Backend configuration, read by backend/src/lbl/settings.py.
APP_ENV=local
LOG_LEVEL=INFO
# Local Docker database (`make db-up`). Plain postgresql:// URLs also work; asyncpg is used.
DATABASE_URL=postgresql+asyncpg://lbl:lbl@localhost:5432/lbl
# Integration tests use their own database (applies and rolls back migrations).
TEST_DATABASE_URL=postgresql+asyncpg://lbl:lbl@localhost:5432/lbl_test
