#!/usr/bin/env bash
# Enforces Conventional Commits and forbids any AI attribution in commit messages.
# Installed by `make setup` (git config core.hooksPath .githooks).
set -euo pipefail

msg_file="$1"
# Ignore comment lines git adds to the editor template.
msg="$(grep -v '^#' "$msg_file" || true)"
first_line="$(printf '%s\n' "$msg" | sed -n '1p')"

# Git-generated merge and revert messages are allowed as-is.
if [[ "$first_line" =~ ^(Merge|Revert\ \") ]]; then
  exit 0
fi

pattern='^(feat|fix|chore|refactor|perf|test|docs|ci|build|style|revert)(\([a-z0-9-]+\))?!?: [a-z0-9].{0,70}$'
if ! [[ "$first_line" =~ $pattern ]]; then
  echo "✖ Commit message must follow Conventional Commits, e.g.:"
  echo "    feat(engine): add cp-sat allocation with voucher thresholds"
  echo "  Rules: type(scope): imperative summary, lowercase start, no full stop, ≤ 72 chars."
  echo "  Got: $first_line"
  exit 1
fi

if [[ "$first_line" =~ \.$ ]]; then
  echo "✖ Summary line must not end with a full stop."
  exit 1
fi

forbidden='co-authored-by|generated with|generated by|created with|claude|anthropic|chatgpt|openai|copilot|gemini|ai-generated|ai generated|ai-assisted|ai assisted|llm-generated|claude\.ai|noreply@anthropic|claude-session'
if printf '%s\n' "$msg" | grep -qiE "$forbidden"; then
  echo "✖ Commit messages must not contain AI attribution, co-author trailers or tool references."
  echo "  Matched line(s):"
  printf '%s\n' "$msg" | grep -inE "$forbidden" | sed 's/^/    /'
  exit 1
fi

exit 0
